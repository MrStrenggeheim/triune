#!/bin/bash
# Modified for Triune: preserve verified deployment and rollback.
# Deploy verified builds and restore interrupted sessions under the systemd lock.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

app=/home/agent/apps/omnigent
legacy_python=/home/agent/.local/share/uv/tools/omnigent/bin/python
source=/home/agent/projects/triune
tool_python="$app/current/venv/bin/python"
[[ -x "$tool_python" ]] || tool_python="$legacy_python"

as_agent() {
    runuser -u agent -- env HOME=/home/agent \
        PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin "$@"
}

discard_failed_published_stage() {
    if [[ -n ${expected_candidate:-} && "$(readlink -f "$app/pending")" == "$expected_candidate" \
        && "$(readlink -f "$app/current")" != "$expected_candidate" ]]; then
        as_agent rm "$app/pending"
    fi
}

# Older stable-update units invoke this script through flock(1), which passes
# its locked file descriptor to the command. Direct invocations take the same lock.
deployment_lock=/run/lock/stable-updates.lock
lock_fd=
for descriptor in /proc/$$/fd/*; do
    if [[ "$(readlink "$descriptor")" == "$deployment_lock" ]]; then
        lock_fd=${descriptor##*/}
        break
    fi
done
if [[ -z $lock_fd ]]; then
    exec {lock_fd}<"$deployment_lock"
fi
flock --nonblock "$lock_fd"

case "${1:-}" in
    --published)
        exec {admission_fd}<"$app"
        flock --wait 2 "$admission_fd" || { echo "Runtime work holds admission." >&2; exit 1; }
        binding=$(as_agent "$source/.venv/bin/python" "$source/deploy/local/published_update.py" apply <&"$lock_fd" 3<&"$admission_fd")
        [[ $binding =~ ^([0-9][0-9A-Za-z.]{0,63}-[0-9a-f]{12})\ ([0-9a-f]{64})$ ]] || exit 1
        expected_candidate="$app/releases/${BASH_REMATCH[1]}"
        manifest_digest=${BASH_REMATCH[2]}
        trap 'if (( $? != 0 )); then discard_failed_published_stage; fi' EXIT
        ;;
    --check|"") ;;
    *) echo "Usage: $0 [--check|--published]" >&2; exit 2 ;;
esac

if [[ ! -L "$app/pending" ]]; then
    [[ ${1:-} != --published ]] || { echo "Published stage disappeared." >&2; exit 1; }
    echo "No custom release staged; the running installation stays unchanged."
    as_agent "$tool_python" - <<'PY'
from importlib.metadata import PackageNotFoundError, version

try:
    installed = version("triune")
except PackageNotFoundError:
    installed = version("omnigent")
print(f"Installed workspace package: {installed}.")
print("Update the Triune main checkout, then run omni-custom build and stage.")
PY
    exit 0
fi

candidate=$(readlink -f "$app/pending")
[[ "$(dirname "$candidate")" == "$app/releases" ]] || { echo "Invalid pending release." >&2; exit 1; }
if [[ ${1:-} == --published ]]; then
    [[ $candidate == "$expected_candidate" ]] || { echo "Staged release changed." >&2; exit 1; }
    actual=$(as_agent sha256sum "$candidate/release.json")
    [[ ${actual%% *} == "$manifest_digest" ]] || { echo "Staged manifest changed." >&2; exit 1; }
fi
manifest=$(as_agent "$source/.venv/bin/python" "$source/deploy/local/manage.py" verify "$(basename "$candidate")")
if [[ -z ${1:-} && ( "$(readlink -f "$app/current")" != "$candidate" || ! -f "$app/session-restart.json" ) ]]; then
    origin=$(/usr/bin/python3 -c 'import json, sys; print(json.load(sys.stdin).get("origin", ""))' <<<"$manifest")
    [[ $origin != github-release ]] || { echo "Published stage requires fenced activation." >&2; exit 1; }
fi
if [[ "${1:-}" == --check ]]; then
    echo "Would restart sessions and deploy $candidate."
    exit 0
fi

if ! systemctl is-active --quiet omnigent.target \
    || ! systemctl is-active --quiet omnigent-server.service \
    || ! systemctl is-active --quiet omnigent-host.service; then
    echo "Omnigent is intentionally stopped or unhealthy; refusing automatic deployment." >&2
    exit 1
fi
sessions="$app/session-restart.json"
restart_sessions() {
    if [[ -n ${admission_fd:-} ]]; then
        exec {admission_fd}<&-
        unset admission_fd
    fi
    as_agent "$tool_python" "$source/deploy/local/session_restart.py" resume "$sessions" \
        --candidate "$(basename "$candidate")"
}
finish_deployment() {
    as_agent "$source/.venv/bin/python" "$source/deploy/local/publication.py" \
        activation-complete "$(basename "$candidate")" || return 75
    if [[ "$(readlink -f "$app/pending")" == "$candidate" ]]; then
        as_agent rm "$app/pending"
    fi
}

# A healthy deployment with delayed session recovery must not restart again.
if [[ "$(readlink -f "$app/current")" == "$candidate" && -f "$sessions" ]]; then
    restart_sessions
    finish_deployment
    echo "Session recovery finished for $(basename "$candidate")."
    exit 0
fi

as_agent "$tool_python" "$source/deploy/local/session_restart.py" capture "$sessions" \
    --candidate "$(basename "$candidate")"

previous=$(readlink -f "$app/current")
backup="$app/backups/$(date -u +%Y%m%dT%H%M%SZ)"
stopped=0
recover() {
    result=$?
    trap - EXIT
    if (( result != 0 && stopped == 1 )); then
        echo "Deployment failed. Restoring the prior code and saved application state." >&2
        systemctl stop omnigent.target omnigent-host.service omnigent-server.service
        as_agent /usr/bin/python3 - "$app" "$previous" "$backup" <<'PY'
import shutil
import sys
from pathlib import Path

app, previous, backup = map(Path, sys.argv[1:])
temporary = app / "current.recover"
temporary.symlink_to(previous)
temporary.replace(app / "current")
state = Path.home() / ".omnigent"
for name in ("chat.db", "config.yaml", "auth_tokens.json"):
    saved = backup / name
    if (backup / "complete").exists() and saved.exists():
        shutil.copy2(saved, state / name)
if (backup / "complete").exists():
    for suffix in ("-wal", "-shm"):
        (state / ("chat.db" + suffix)).unlink(missing_ok=True)
PY
        systemctl start omnigent.target omnigent-server.service omnigent-host.service || echo "Service recovery needs attention." >&2
        restart_sessions || echo "Saved sessions need another recovery attempt." >&2
    fi
    if (( result != 0 )); then discard_failed_published_stage; fi
    exit "$result"
}
trap recover EXIT

# Wait for both processes: stopping a target alone can return while its
# propagated service jobs are still queued, and a subsequent start cancels them.
if ! systemctl stop omnigent.target omnigent-host.service omnigent-server.service; then
    systemctl start omnigent.target omnigent-server.service omnigent-host.service
    for unit in omnigent.target omnigent-server.service omnigent-host.service; do
        systemctl is-active --quiet "$unit" || { echo "Service recovery needs attention: $unit" >&2; exit 1; }
    done
    exit 1
fi
stopped=1
as_agent /usr/bin/python3 - "$app" "$candidate" "$previous" "$backup" "$sessions" <<'PY'
import shutil
import sqlite3
import sys
from pathlib import Path

app, candidate, previous, backup, sessions = map(Path, sys.argv[1:])
backup.mkdir(parents=True, mode=0o700)
state = Path.home() / ".omnigent"
with sqlite3.connect(state / "chat.db") as original:
    with sqlite3.connect(backup / "chat.db") as saved:
        original.backup(saved)
for name in ("config.yaml", "auth_tokens.json"):
    path = state / name
    if path.exists():
        shutil.copy2(path, backup / name)
shutil.copy2(sessions, backup / "session-restart.json")
(backup / "complete").touch()
for name, target in (("previous", previous), ("current", candidate)):
    temporary = app / (name + ".new")
    temporary.symlink_to(target)
    temporary.replace(app / name)
for command in ("triune", "omnigent", "omni"):
    target = Path.home() / ".local/bin" / command
    temporary = target.with_name(command + ".new")
    temporary.symlink_to(app / "current/venv/bin" / command)
    temporary.replace(target)
PY

systemctl start omnigent.target omnigent-server.service omnigent-host.service
for attempt in {1..30}; do
    if systemctl is-active --quiet omnigent-server.service \
        && systemctl is-active --quiet omnigent-host.service \
        && as_agent /usr/bin/python3 - "$candidate" "${1:-}" <<'PY'
import json
import subprocess
import sys
from pathlib import Path
from urllib.request import urlopen

candidate = Path(sys.argv[1])
expected = json.loads((candidate / "release.json").read_text())["version"]
with urlopen("http://127.0.0.1:6767/health", timeout=5) as response:
    assert json.load(response)["status"] == "ok"
with urlopen("http://127.0.0.1:6767/api/version", timeout=5) as response:
    identity = json.load(response)
    assert identity["version"] == expected
    if sys.argv[2] == "--published":
        assert identity.get("release_admission") == "draining"
for unit in ("omnigent-server.service", "omnigent-host.service"):
    pid = subprocess.check_output(["systemctl", "show", unit, "-p", "MainPID", "--value"], text=True).strip()
    argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    assert argv[0].startswith(str(candidate / "venv/bin/python").encode()), unit
PY
    then
        stopped=0
        restart_sessions
        finish_deployment
        echo "Deployed $(basename "$candidate"). Previous release: $previous. Backup: $backup."
        exit 0
    fi
    sleep 2
done
echo "Custom release failed its startup checks." >&2
exit 1
