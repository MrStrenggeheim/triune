  "runtime": {
    "dependencies": [],
    "external_cdns": false,
    "entry": "window.TriuneArtifact.init(root)",
    "automatic_mount": "[data-ta-init]",
    "network": "none",
    "available_height": "TriuneArtifact.maximumBodyHeight / --ta-max-body-height; listen for triune-artifact:layout; undefined outside an inline host"
  },
  "native_behavior": {
    "supported": [
      "tabs",
      "disclosure",
      "arrowless tooltip",
      "theme control",
      "density control",
      "native checkbox and mixed state",
      "native range",
      "native progress"
    ],
    "form_controls": {
      "checkbox": "input[type=checkbox]; .ta-choice label supplies the touch target; data-ta-mixed initializes indeterminate",
      "range": "input[type=range]; native min/max/step/value; optional refresh(root) after programmatic writes",
      "progress": "progress[value][max]; omit value for unknown progress; ta-progress--usage uses the flat usage track"
    },
    "parity_limits": [
      "Native adapters do not import React or Radix behavior.",
      "Native select popups and radio paint remain browser-owned.",
      "Content tabs do not reproduce dock layout, pinning, or selection strips.",
      "Host tokens override fallbacks through getArtifactThemeVariables(root)."
    ]
  },
  "components": {
    "button": {
      "export": "Button",
      "module": "@/components/ui/button",
      "radii": [8, 6, 4]
    },
    "field": {
      "export": "Input",
      "module": "@/components/ui/input",
      "radii": [8]
    },
    "textarea": {
      "export": "Textarea",
      "module": "@/components/ui/textarea",
      "radii": [8]
    },
    "checkbox": {
      "export": "Checkbox",
      "module": "@/components/ui/checkbox",
      "radii": [4]
    },
    "select": {
      "export": "SelectTrigger",
      "module": "@/components/ui/select",
      "radii": [8, 6]
    },
    "headerAction": {
      "export": "HeaderActionButton",
      "module": "@/components/HeaderActionButton",
      "radii": [6]
    },
    "close": {
      "export": "CloseButton",
      "module": "@/components/CloseButton",
      "radii": [4]
    }
  },
  "exceptions": {
    "badge": {
      "module": "@/components/ui/badge",
      "shape": "20.8px pill"
    },
    "tooltip": {
      "module": "@/components/ui/tooltip",
      "radius": 7
    },
    "switch": {
      "module": "@/components/ui/switch",
